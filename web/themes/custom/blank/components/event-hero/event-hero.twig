{#
/**
 * @file
 * Event hero component.
 *
 * Pass rendered Drupal Media/image field output into the hero_image slot.
 */
#}
{% set variant = theme_variant|default('warm') %}
{% set image_position = image_position|default('right') %}

<section class="event-hero
  event-hero--{{ variant|clean_class }}
  event-hero--image-{{ image_position|clean_class }}">
  {# Image first in source order: it is also first on mobile. #}
  {% if image %}
    <div class="event-hero__media">
      {% include 'canvas:image' with image|merge({
      loading: 'eager',
      sizes: '(max-width: 767px) 100vw, 50vw',
      class: 'event-hero__image'
    }) only %}
    </div>
  {% endif %}

  <div class="event-hero__content">
    <div class="event-hero__content-inner">
      {% if eyebrow %}
        <p class="event-hero__eyebrow">{{ eyebrow }}</p>
      {% endif %}

      {% if title %}
        <h1 class="event-hero__title">{{ title }}</h1>
      {% endif %}

      {% if summary %}
        <div class="event-hero__summary">{{ summary }}</div>
      {% endif %}

      {% if date_text or venue_name or venue_location %}
        <div class="event-hero__details">
          {% if date_text %}
            <div class="event-hero__detail">
              {% if date_icon %}
                
                <img src="{{ date_icon.src }}" alt="" width="36" height="36">
              {% endif %}
              <span>{{ date_text }}</span>
            </div>
          {% endif %}
          {% if venue_name or venue_location %}
            <div class="event-hero__detail">
              {% if venue_icon %}
                <img src="{{ venue_icon.src }}" alt="" width="36" height="36">
              {% endif %}
              <span>
                {% if venue_name %}<span>{{ venue_name }}</span>{% endif %}
                {% if venue_location %}<span>{{ venue_location }}</span>{% endif %}
              </span>
            </div>
          {% endif %}
        </div>
      {% endif %}

      {% if primary_cta_url or secondary_cta_url %}
        <div class="event-hero__actions">
          {% if primary_cta_url and primary_cta_label %}
            <a class="event-hero__button event-hero__button--primary" href="{{ primary_cta_url }}">{{ primary_cta_label }}</a>
          {% endif %}
          {% if secondary_cta_url and secondary_cta_label %}
            <a class="event-hero__button event-hero__button--secondary" href="{{ secondary_cta_url }}">{{ secondary_cta_label }}</a>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</section>
